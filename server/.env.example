# Copie este arquivo para server/.env e preencha com as credenciais do Supabase
# (Project Settings -> Database -> Connection string).
# O .env está no .gitignore — nunca commite as senhas.

# Conexão COM POOLING (porta 6543) — usada pelo app em runtime.
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão DIRETA (porta 5432) — usada SÓ pelo Prisma CLI (migrations).
# Trocar as duas causa erros que não dizem qual é o problema.
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Usuário da loja, criado pelo seed (npm run db:seed).
# Provisório: vira o usuário logado quando o auth (Parte 4) entrar.
STORE_USER_ID="00000000-0000-0000-0000-000000000001"

PORT=3333

# --- Alternativa: Postgres local via Docker (docker compose up -d na raiz) ---
# Local não tem pooler, então as duas URLs são iguais:
# DATABASE_URL="postgresql://tcg:tcg@localhost:5432/tcgpumpkin"
# DIRECT_URL="postgresql://tcg:tcg@localhost:5432/tcgpumpkin"
