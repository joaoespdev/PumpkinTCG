# Dependências (instaladas via npm install)
node_modules/

# Saída de build
dist/
dist-ssr/

# Caches do Vite
.vite/

# Cache do build incremental do TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Código gerado pelo Prisma (recriável com `npx prisma generate`)
server/src/generated/

# Variáveis de ambiente (segredos, chaves de API)
.env
.env.local
.env.*.local

# Arquivos do sistema operacional
.DS_Store
Thumbs.db

# Configurações de editor
.vscode/*
!.vscode/extensions.json
.idea/
